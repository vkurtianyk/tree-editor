@* Toolbar Apply and "Discard all changes" for the local cache's pending changes, and the leave-page warning
   while any are pending. Apply is disabled while nothing is pending, a request is in flight or a conflict is
   unresolved; after it succeeds, or is rejected with conflicts, DBTreeView reloads from the roots. *@
@using System.Net
@implements IDisposable
@inject LocalCache Cache
@inject DbTreeReload DbTree
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<NavigationLock ConfirmExternalNavigation="@Cache.HasPendingChanges" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

<MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.CloudUpload"
           Disabled="@(!Cache.CanApply)" OnClick="ApplyAsync">
    @(Cache.IsApplying ? "Applying…" : "Apply")
</MudButton>
<MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Undo"
           Disabled="@(!Cache.HasPendingChanges || Cache.IsApplying)" OnClick="Cache.DiscardAll">
    Discard all changes
</MudButton>

@code {
    protected override void OnInitialized() => Cache.Changed += OnCacheChanged;

    private async Task ApplyAsync()
    {
        try
        {
            // Nothing was stored when the click came after Apply was disabled, or a Reset cleared the cache while
            // the request was in flight; the Reset's own message and reload stand then.
            if (!await Cache.ApplyAsync())
            {
                return;
            }

            DbTree.Request();
            Snackbar.Add("The changes are applied.", Severity.Success);
        }
        catch (ApplyRejectedException rejected) when (rejected.StatusCode == HttpStatusCode.Conflict)
        {
            // The database moved on: show it as it is now next to the conflicts CachedTreeView marks.
            DbTree.Request();
            Snackbar.Add(ConflictSummary(rejected.Conflicts), Severity.Warning);
        }
        catch (HttpRequestException ex)
        {
            // After a Reset cleared the cache, nothing is pending any more.
            var pending = Cache.HasPendingChanges ? "; the changes are still pending" : "";
            Snackbar.Add($"Apply failed{pending}. {ex.Message}", Severity.Error);
        }
    }

    private string ConflictSummary(IReadOnlyList<NodeConflict> conflicts)
    {
        var deleted = conflicts.Count(conflict => conflict.Reason == ConflictReason.Deleted);
        var summary = $"Nothing was applied: {conflicts.Count} element(s) changed in the database.";
        if (deleted > 0)
        {
            summary += $" {deleted} of them were deleted there, so the changes under them were dropped.";
        }

        if (Cache.HasUnresolvedConflicts)
        {
            return summary + $" Resolve {(deleted > 0 ? "the others" : "each")} with Take DB or Keep mine, then Apply again.";
        }

        return summary + (Cache.HasPendingChanges
            ? " Apply again to send the remaining changes."
            : " No changes are left to apply.");
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (!Cache.HasPendingChanges)
        {
            return;
        }

        var leave = await Dialogs.ShowMessageBoxAsync(
            "Leave with pending changes?",
            "The changes in the cache are not applied and will be lost.",
            yesText: "Leave",
            cancelText: "Stay");
        if (leave != true)
        {
            context.PreventNavigation();
        }
    }

    private async void OnCacheChanged() => await InvokeAsync(StateHasChanged);

    public void Dispose() => Cache.Changed -= OnCacheChanged;
}
