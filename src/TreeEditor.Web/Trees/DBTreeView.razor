@* The database tree, read lazily: the roots first, one level per expand, wide levels a page at a time. *@
@inject TreeApiClient Api

<div class="tree" role="tree" aria-label="Database tree">
    @if (roots.IsLoaded && roots.Nodes.Count == 0)
    {
        <MudText Typo="Typo.body2">The database is empty.</MudText>
    }
    <DbTreeLevelView Level="roots" />
</div>

@code {
    private readonly DbTreeLevel roots = new(parentId: null);

    protected override Task OnInitializedAsync() => roots.LoadNextPageAsync(Api);
}
