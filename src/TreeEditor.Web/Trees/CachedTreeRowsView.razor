@* One level of CachedTreeView: element rows (selectable) and placeholder rows (not), each followed by its children.
   An element whose change conflicts with the database shows the database's value and Take DB / Keep mine. *@

@foreach (var row in Rows)
{
    @switch (row)
    {
        case CachedElementRow { Element: var element }:
            <div @key="row.Key" role="treeitem" data-node-id="@element.Id"
                 aria-selected="@(element.Id == SelectedId ? "true" : "false")">
                <div class="tree-row">
                    <span class="@ValueClass(element)" @onclick="() => OnSelect.InvokeAsync(element.Id)">@element.Value</span>
                    @if (element.State == ElementState.Edited)
                    {
                        <span class="tree-marker edited" title="Edited; not applied yet">edited</span>
                    }
                    @if (element.State == ElementState.New)
                    {
                        <span class="tree-marker new" title="New; not applied yet">new</span>
                    }
                    @if (element.State == ElementState.Deleted)
                    {
                        <span class="tree-marker deleted" title="Deleted; not applied yet">deleted</span>
                    }
                    @if (element.Conflict is { } conflict)
                    {
                        <span class="tree-marker conflict" title="@ConflictTitle(element, conflict)">changed elsewhere</span>
                        <span class="tree-conflict-value">database: "@conflict.Value"</span>
                        <MudButton Class="tree-conflict-action" Variant="Variant.Outlined" Color="Color.Warning"
                                   Size="Size.Small" title="Take the database's value and drop your change"
                                   OnClick="() => OnTakeDatabase.InvokeAsync(element.Id)">
                            Take DB
                        </MudButton>
                        <MudButton Class="tree-conflict-action" Variant="Variant.Outlined" Color="Color.Warning"
                                   Size="Size.Small" title="Keep your change; the next Apply overwrites the database's"
                                   OnClick="() => OnKeepMine.InvokeAsync(element.Id)">
                            Keep mine
                        </MudButton>
                    }
                </div>
                @ChildrenOf(row)
            </div>
            break;
        case PlaceholderRow placeholder:
            <div @key="row.Key" role="treeitem" aria-disabled="true">
                <div class="tree-row">
                    <span class="tree-placeholder">
                        … @placeholder.MissingLevels @(placeholder.MissingLevels == 1 ? "level" : "levels") not loaded
                    </span>
                </div>
                @ChildrenOf(row)
            </div>
            break;
    }
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<CachedTreeRow> Rows { get; set; } = null!;

    [Parameter]
    public Guid? SelectedId { get; set; }

    [Parameter]
    public EventCallback<Guid> OnSelect { get; set; }

    [Parameter]
    public EventCallback<Guid> OnTakeDatabase { get; set; }

    [Parameter]
    public EventCallback<Guid> OnKeepMine { get; set; }

    private static string ConflictTitle(CachedElement element, NodeConflict conflict) =>
        $"Changed in the database after it was loaded; it is now \"{conflict.Value}\"."
        + (element.State == ElementState.Deleted ? " Keep mine deletes it anyway." : " Keep mine applies your value.");

    private string ValueClass(CachedElement element) =>
        "tree-value selectable"
        + (element.IsDeleted ? " deleted" : "")
        + (element.State == ElementState.Edited ? " edited" : "")
        + (element.Id == SelectedId ? " selected" : "");

    private RenderFragment? ChildrenOf(CachedTreeRow row) => row.Children.Count == 0
        ? null
        : @<div role="group" class="tree-group">
               <CachedTreeRowsView Rows="row.Children" SelectedId="SelectedId" OnSelect="OnSelect"
                                   OnTakeDatabase="OnTakeDatabase" OnKeepMine="OnKeepMine" />
           </div>;
}
